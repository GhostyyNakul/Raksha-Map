{
  "name": "rakshamap-sih-2026",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "install:all": "npm install && npm --prefix server install",
    "admin:set": "npm --prefix server run admin:set"
  },
  "dependencies": {
    "@maptiler/sdk": "^4.1.0",
    "firebase": "^12.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
